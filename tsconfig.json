{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"types": ["vite/client"],
		"declaration": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		//    "verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,
		"jsx": "react-jsx",
		"declarationMap": true,
		"outDir": "./dist/",
		"sourceMap": true,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		//    "noImplicitReturns": true,
		"noImplicitAny": true,
		/* Linting */
		"strict": true,
		//    "noUnusedLocals": true,
		//    "noUnusedParameters": true,
		////    "erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true,
		//    "noUncheckedSideEffectImports": true,
		"paths": {
			// Platinum, the workspace package @classicy/appearance-platinum, reaches
			// the core as `@classicy/classicy` (plan 0015-kxa §3.1).
			"@classicy/classicy": ["./src/index.ts"],
			"@classicy/appearance-platinum": [
				"./packages/appearance/platinum/src/index.ts"
			],
			// System 7, the workspace package @classicy/appearance-system7
			// (plan 0018-dbd §2.2), the same way.
			"@classicy/appearance-system7": [
				"./packages/appearance/system7/src/index.ts"
			],
			"@/*": ["./src/*"],
			"@img/*": ["./assets/img/*"],
			"@vid/*": ["./assets/vid/*"]
		}
	},
	"exclude": [
		"example/",
		"rt911/",
		"storybook/",
		"src/**/*.stories.tsx",
		// Type-checked under storybook/tsconfig.json, with Storybook's types.
		"packages/appearance/*/src/**/*.stories.tsx"
	]
}
