{
	"name": "classicy-example",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite -d",
		"build": "tsc -b && vite build",
		"lint": "biome check .",
		"preview": "vite preview",
		"use:local": "pnpm add classicy@workspace:* && pnpm install",
		"use:published": "pnpm add classicy@latest",
		"proxy": "pnpm proxy:up",
		"proxy:cycle": "pnpm proxy:down && pnpm proxy:up",
		"proxy:up": "cd timemachine && docker compose up --build --force-recreate -d",
		"proxy:down": "cd timemachine && docker compose down"
	},
	"dependencies": {
		"classicy": "workspace:*",
		"dompurify": "^3.4.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@types/dompurify": "^3.0.5",
		"@types/node": "^24.1.0",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"typescript": "~5.9.3",
		"vite": "^7.3.2"
	},
	"volta": {
		"node": "25.2.0"
	}
}
