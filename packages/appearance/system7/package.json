{
	"name": "@classicy/appearance-system7",
	"version": "3.1.1",
	"description": "System 7, the classic Mac OS look in black and white and in color, as an Appearance Package for Classicy.",
	"keywords": [
		"classicy",
		"appearance-package",
		"system7",
		"macos-classic",
		"react"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/robbiebyrd/classicy",
		"directory": "packages/appearance/system7"
	},
	"author": "Robbie Byrd <me@robbiebyrd.com>",
	"license": "Unlicense",
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"types": "./dist/types/index.d.ts",
	"main": "./dist/appearance-system7.umd.js",
	"module": "./dist/appearance-system7.es.js",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/appearance-system7.es.js",
			"require": "./dist/appearance-system7.umd.js"
		},
		"./scss/*": "./src/styles/*",
		"./classicy-system7.css": "./dist/classicy-system7.css",
		"./classicy-system7.fonts.css": "./dist/classicy-system7.fonts.css"
	},
	"files": [
		"dist",
		"src/styles",
		"README.md",
		"LICENSE"
	],
	"sideEffects": [
		"./dist/*.js",
		"./src/index.ts",
		"./src/assets/system7Assets.ts",
		"./src/assets/sounds/system7.ts",
		"**/*.css",
		"**/*.scss"
	],
	"scripts": {
		"build": "vite build && pnpm verify:dist",
		"verify:dist": "node bin/verify-dist.mjs",
		"test": "vitest run"
	},
	"peerDependencies": {
		"@classicy/classicy": "workspace:^",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@classicy/classicy": "workspace:*"
	}
}
